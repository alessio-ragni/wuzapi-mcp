# Copy to .env and fill in. `scripts/init-env.sh` does it for you with random values.
# .env is never committed.

# --- WuzAPI ---------------------------------------------------------------
# Admin token: creates and lists WuzAPI users. Long and random.
WUZAPI_ADMIN_TOKEN=
# Encrypts secrets inside WuzAPI's database. Exactly 32 characters. Never change it
# after the first start, or what it encrypted can no longer be read.
WUZAPI_GLOBAL_ENCRYPTION_KEY=
# Signs every webhook WuzAPI sends to wuzapi-mcp. At least 32 characters.
WUZAPI_GLOBAL_HMAC_KEY=
# Where WuzAPI posts events. Empty until wuzapi-mcp's receiver exists.
WUZAPI_GLOBAL_WEBHOOK=

# The WuzAPI user that holds your WhatsApp session, and its API token.
WUZAPI_USER_NAME=owner
WUZAPI_USER_TOKEN=

# Messages WuzAPI keeps per chat, so nothing synced at pairing is lost.
WUZAPI_HISTORY_PER_CHAT=1000
# Days of history to ask the phone for when linking (0–365). Applies to a new pairing only.
WUZAPI_SYNC_DAYS=365

# Name of the linked device, as the phone shows it under Linked devices.
SESSION_DEVICE_NAME=wuzapi-mcp

# Local port for WuzAPI, bound to 127.0.0.1 only.
WUZAPI_HOST_PORT=8090
TZ=UTC
